<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Version>1.3.3-roadmap.1</Version>
    <LocalEsoDataProject Condition="'$(LocalEsoDataProject)' == ''">$(MSBuildThisFileDirectory)../EsoData.NET/src/EsoData/EsoData.csproj</LocalEsoDataProject>
  </PropertyGroup>
</Project>
